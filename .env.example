# Copy this file to .env (same folder) and put your own API key(s) in it.
# You need at least ONE of: a Gemini key or an Orynx key. With both, Gemini is used first and Orynx
# takes over automatically when every Gemini key/model is used up (429 / quota / 503 / timeout).

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# Optional: more Gemini keys (one Google project each) are tried in order when one is used up:
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# --- Orynx (https://orynx.dev - one API for many models; Gemini-compatible endpoint) ---
ORYNX_API_KEY=
# Optional: more Orynx keys, tried in order:
# ORYNX_API_KEY_2=
# Optional: only if Orynx ever changes its address (host only, no /v1):
# ORYNX_BASE_URL=https://api.orynx.dev
# Optional: Orynx model(s) to use, comma separated, first one first (see https://orynx.dev/models):
# ORYNX_MODELS=gemini-3.8-flash

# Which provider first? Default: gemini,orynx.   Orynx first: orynx,gemini.   Orynx only: orynx
# TRANSLATION_PROVIDER_ORDER=gemini,orynx

# Optional: only if Gemini needs a proxy on this PC (e.g. v2rayN). "none" = always direct.
# Orynx is always direct unless you set ORYNX_PROXY.
# GEMINI_PROXY=http://127.0.0.1:10808
# ORYNX_PROXY=

# Optional: Edge TTS (the Burmese voice) normally needs NO proxy - Microsoft refuses many VPN servers (403).
# Only on a network where the voice works just through a proxy: EDGE_TTS_PROXY=http://127.0.0.1:<port>
# EDGE_TTS_PROXY=

# Optional: the Whisper model (~460 MB for English, ~480 MB for Chinese "small", first run only) comes from
# huggingface.co. No account or HF_TOKEN is needed. Only if huggingface.co does not open on this PC, use a mirror:
# HF_ENDPOINT=https://hf-mirror.com
